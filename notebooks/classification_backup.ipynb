    "# Display data types\n",
    "print(\"\\nData Types:\")\n",
    "print(df.dtypes)\n",
    "\n",
    "# Display missing-value counts\n",
    "print(\"\\nMissing Values:\")\n",
    "print(df.isnull().sum())\n",
    "\n",
    "# Display target/class distribution\n",
    "print(\"\\nTarget Distribution:\")\n",
    "print(df[\"Satisfaction\"].value_counts())"
